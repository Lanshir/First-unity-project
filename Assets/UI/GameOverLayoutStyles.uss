:root {
    --game-over-red: rgb(180, 0, 0);
    --game-over-red-a10: rgba(180, 0, 0, 0.1);
    --game-over-bg: rgb(0, 0, 0);
    --font-medium: 24px;
}

* {
    margin: 0;
    padding: 0;
}

Label {
    color: var(--game-over-red);
    font-size: var(--font-medium);
}

Button {
    font-size: var(--font-medium);
    color: var(--game-over-red);
    background-color: var(--game-over-bg);
    border-color: var(--game-over-red);
    border-radius: 8px;
    border-width: 4px;
    margin-top: 18px;
    padding: 8px 16px;
    width: 240px;
}

Button:hover {
    background-color: var(--game-over-red-a10);
}

#MenuContainer {
    background-color: var(--game-over-bg);
}
